<?xml version="1.0" encoding="utf-8"?>
<!-- Sora (SIL Open Font License), the font of the Claude Design "Onboarding v2" screens. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/sora_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/sora_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/sora_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/sora_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/sora_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/sora_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/sora_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/sora_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
