<?xml version="1.0" encoding="utf-8"?>
<!-- Sticker Pop first category tile, tinted with the accent (22% over the background): 2dp neon edge and a hard 3dp offset shadow in the edge colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape><corners android:radius="@dimen/_10sdp" /><solid android:color="@color/sh_edge" /></shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape><corners android:radius="@dimen/_10sdp" /><solid android:color="#102048" /><stroke android:width="2dp" android:color="@color/sh_edge" /></shape>
    </item>
</layer-list>
