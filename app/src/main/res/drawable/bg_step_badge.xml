<?xml version="1.0" encoding="utf-8"?>
<!-- Sticker Pop step number: accent sticker, 2dp edge, hard 3dp offset shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape><corners android:radius="@dimen/_7sdp" /><solid android:color="@color/sh_edge" /></shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape><corners android:radius="@dimen/_7sdp" /><solid android:color="@color/sh_primary" /><stroke android:width="2dp" android:color="@color/sh_edge" /></shape>
    </item>
</layer-list>
