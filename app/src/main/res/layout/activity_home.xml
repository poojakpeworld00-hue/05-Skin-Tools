<?xml version="1.0" encoding="utf-8"?>
<!-- Home, Claude Design "Skin Hub Variants" Sticker Pop: tilted brand tag, outlined 2-column category tiles, tools list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg">

    <View
        android:id="@+id/glow"
        android:layout_width="@dimen/_350sdp"
        android:layout_height="@dimen/_240sdp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/_minus60sdp"
        android:layout_marginEnd="@dimen/_minus50sdp"
        android:background="@drawable/bg_corner_glow" />

<LinearLayout
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<androidx.core.widget.NestedScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_17sdp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_3sdp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sticker_tag"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:rotation="-2"
                    android:text="@string/home_brand"
                    android:textColor="@color/sh_on_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headline"
                    style="@style/SH.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/explore_today"
                    android:textAlignment="viewStart"
                    android:textSize="@dimen/_16ssp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="@dimen/_33sdp"
                android:layout_height="@dimen/_33sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/bg_settings_btn"
                android:contentDescription="@string/settings"
                android:padding="@dimen/_9sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/sh_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">

        <FrameLayout
            android:id="@+id/tileCharacters"
            android:layout_width="0dp"
            android:layout_height="@dimen/_83sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_sticker_tile_tint"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_sticker_press">

            <ImageView
                android:id="@+id/tileCharactersArt"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@drawable/ch_alok" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/cat_characters"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tileBundles"
            android:layout_width="0dp"
            android:layout_height="@dimen/_83sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_9sdp"
            android:background="@drawable/bg_sticker_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_sticker_press">

            <ImageView
                android:id="@+id/tileBundlesArt"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@drawable/fc_bundles2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/cat_bundles"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_9sdp">

        <FrameLayout
            android:id="@+id/tileWeapons"
            android:layout_width="0dp"
            android:layout_height="@dimen/_83sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_sticker_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_sticker_press">

            <ImageView
                android:id="@+id/tileWeaponsArt"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@drawable/fc_weapons2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/cat_weapons"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tilePets"
            android:layout_width="0dp"
            android:layout_height="@dimen/_83sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_9sdp"
            android:background="@drawable/bg_sticker_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_sticker_press">

            <ImageView
                android:id="@+id/tilePetsArt"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@drawable/fc_pets2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/cat_pets"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_9sdp">

        <FrameLayout
            android:id="@+id/tileEmotes"
            android:layout_width="0dp"
            android:layout_height="@dimen/_83sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_sticker_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_sticker_press">

            <ImageView
                android:id="@+id/tileEmotesArt"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@drawable/fc_emotes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/cat_emotes"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tileVehicles"
            android:layout_width="0dp"
            android:layout_height="@dimen/_83sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_9sdp"
            android:background="@drawable/bg_sticker_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/fg_sticker_press">

            <ImageView
                android:id="@+id/tileVehiclesArt"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@drawable/fc_vehicles" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/cat_vehicles"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/toolsTitle"
            style="@style/SH.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_3sdp"
            android:text="@string/tools_guides"
            android:textSize="@dimen/_12ssp" />

        <LinearLayout
            android:id="@+id/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- list_ad: moved to RC's list_ad_position at runtime. -->
        <FrameLayout
            android:id="@+id/adInline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <!-- bottom_ad: pinned, full width, no margin. -->
    <FrameLayout
        android:id="@+id/adSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
