<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg">

    <View
        android:id="@+id/glow"
        android:layout_width="@dimen/_350sdp"
        android:layout_height="@dimen/_240sdp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/_minus60sdp"
        android:layout_marginEnd="@dimen/_minus50sdp"
        android:background="@drawable/bg_corner_glow" />

    <FrameLayout
        android:id="@+id/bannerBox"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_192sdp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.5"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_banner_fade" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/_32sdp"
            android:paddingStart="@dimen/_8sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingEnd="@dimen/_8sdp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="@dimen/_7sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/sh_muted" />

            <!-- Sticker Pop step header: the number on a tilted accent sticker, then the step name and "of N". -->
            <LinearLayout
                android:id="@+id/tracker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stepNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_step_badge"
                    android:fontFamily="@font/brand_extrabold"
                    android:includeFontPadding="false"
                    android:paddingStart="@dimen/_9sdp"
                    android:paddingTop="@dimen/_4sdp"
                    android:paddingEnd="@dimen/_11sdp"
                    android:paddingBottom="@dimen/_6sdp"
                    android:rotation="-3"
                    android:textColor="@color/sh_on_accent"
                    android:textSize="@dimen/_15ssp"
                    app:fontFamily="@font/brand_extrabold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stepName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stepTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:textColor="@color/sh_muted"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:minHeight="@dimen/_32sdp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_8sdp"
                android:text="@string/skip"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sticker Pop progress: a 14dp bar with a 2dp neon edge; the accent fill grows inside it. -->
        <FrameLayout
            android:id="@+id/progressFrame"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginHorizontal="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_progress_frame"
            android:padding="2dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:max="13"
                app:indicatorColor="@color/sh_primary"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="5dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="10dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/SH.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:paddingHorizontal="@dimen/_17sdp"
                android:paddingTop="@dimen/_10sdp"
                android:textAlignment="viewStart" />

            <TextView
                android:id="@+id/sub"
                style="@style/SH.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:paddingHorizontal="@dimen/_17sdp"
                android:textAlignment="viewStart" />

            <LinearLayout
                android:id="@+id/favRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_17sdp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/favCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:textColor="@color/sh_primary"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/favAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="@dimen/_26sdp"
                    android:textColor="@color/sh_text"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:scrollbars="none" />

            <include
                android:id="@+id/homeDemo"
                layout="@layout/view_home_demo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:background="@drawable/bg_cta_clip">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/next"
                style="@style/SH.Cta"
                android:layout_width="match_parent" />

            <View
                android:id="@+id/ctaShine"
                android:layout_width="@dimen/_23sdp"
                android:layout_height="@dimen/_37sdp"
                android:background="@drawable/bg_shine"
                android:importantForAccessibility="no"
                android:rotation="15"
                android:scaleY="1.6"
                android:translationZ="8dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/adSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
