<?xml version="1.0" encoding="utf-8"?>
<!-- Default-home hint: bottom sheet over the system "Default home app" list (design: Onboarding home hint). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Scrim; a tap here closes the hint (same id as the other hint layout's close target). -->
    <View
        android:id="@+id/llBaseIx"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lnch_home_hint_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/homeHintSheetIx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hs_home_hint_sheet"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="16dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:alpha="0.35"
            android:background="@drawable/hs_home_hint_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/homeHintTileIx"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/hs_home_hint_tile">

                <ImageView
                    android:id="@+id/homeHintSpinIx"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hs_home_hint_spin" />

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/hs_home_hint_tile_inner">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hs_home_hint_home" />

                </FrameLayout>

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeHintTitleIx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/familjen_grotesk"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:lineHeight="22sp"
                    android:text="@string/launcher_hint_default_home_title"
                    android:textColor="@color/lnch_home_hint_ink"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/hs_home_hint_list"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="8dp">

            <include layout="@layout/lx_hint_demo_cell" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipChildren="false">

                <!-- Padding includes the 2dp accent border (the design's padding sits inside it). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hs_home_hint_row"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:elevation="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/lnch_home_hint_accent"
                    android:outlineSpotShadowColor="@color/lnch_home_hint_accent"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="46dp"
                    android:paddingBottom="12dp">

                    <!-- 44dp box (the halo's largest size: 34dp × 1.3) around the 20dp radio, pulled in by -12dp margins so the
                         row layout is unchanged and the halo never gets cropped at the radio's edge. -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="-12dp"
                        android:layout_marginTop="-12dp"
                        android:layout_marginEnd="-12dp"
                        android:layout_marginBottom="-12dp">

                        <View
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:background="@drawable/hs_home_hint_radio_on" />

                        <View
                            android:id="@+id/homeHintHaloIx"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:alpha="0"
                            android:background="@drawable/hs_home_hint_radio_on" />

                        <View
                            android:id="@+id/homeHintDotIx"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center"
                            android:background="@drawable/hs_home_hint_dot"
                            android:scaleX="0"
                            android:scaleY="0" />

                    </FrameLayout>

                    <ImageView
                        android:id="@+id/homeHintAppIconIx"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/hs_home_hint_icon_clip"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/homeHintAppLabelIx"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:breakStrategy="balanced"
                        android:fontFamily="@font/familjen_grotesk"
                        android:includeFontPadding="false"
                        android:lineHeight="20sp"
                        android:textColor="@color/lnch_home_hint_ink"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Above the row (row has elevation); no background, so it casts no shadow. -->
                <ImageView
                    android:id="@+id/homeHintPointerIx"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="-10dp"
                    android:elevation="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hs_home_hint_pointer"
                    android:translationX="10dp"
                    android:translationY="14dp" />

            </FrameLayout>

            <include
                layout="@layout/lx_hint_demo_cell"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/homeHintTextIx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/familjen_grotesk"
            android:gravity="center"
            android:lineHeight="19sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/lnch_home_hint_ink2"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/homeHintGotItIx"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/hs_home_hint_button"
            android:fontFamily="@font/familjen_grotesk"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/launcher_hint_default_home_got_it"
            android:textAllCaps="false"
            android:textColor="@color/lnch_home_hint_button_text"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
